# PostgreSQL Connection (e.g. Neon, Supabase, or local Postgres)
# Trueself falls back automatically to zero-config persistent local storage if unset.
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/neondb?sslmode=require"
NEON_BRANCH=main

# Optional OpenAI API Key for deep reflection follow-ups
# OPENAI_API_KEY=
# TRUESELF_AI_MODEL=gpt-4o-mini
